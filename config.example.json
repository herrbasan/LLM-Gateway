{
  "port": 3400,
  "host": "0.0.0.0",
  
  "models": {
    "_comment": "=== LLM GATEWAY MODEL CONFIGURATION ===",
    "_comment_provider": "provider is the model's vendor (Google, Moonshot, OpenAI, Anthropic, xAI, Z.ai, DeepSeek, MiniMax, Mistral, Alibaba, ...), distinct from 'adapter' — the wire protocol used to reach it. It is published as 'provider' in GET /v1/models so a client can group models by vendor. Optional: a model without one is simply ungrouped.",
    
    "_comment_llamacpp": "--- llama.cpp wrapper (OpenAI-compatible) ---",
    "_comment_llamacpp_note": "The wrapper is a standalone process manager for llama-server. Configure launch params (pooling, ctxSize, etc.) in the wrapper's models.json, not here. The gateway only needs adapterModel (the model name) and endpoint.",
    
    "llama-chat": {
      "type": "chat",
      "adapter": "openai",
      "provider": "Meta",
      "endpoint": "http://localhost:4080/v1",
      "adapterModel": "publisher/model-name",
      "maxTokens": 8192,
      "extraBody": {
        "stop": ["<end_of_turn>"]
      },
      "capabilities": {
        "contextWindow": 128000,
        "vision": true,
        "streaming": true,
        "structuredOutput": true,
        "tools": true,
        "thinking": "chat_template_kwargs"
      },
      "_comment_thinking": "capabilities.thinking='chat_template_kwargs' lets enable_thinking reach llama.cpp/Qwen upstreams via the openai adapter.",
      "_comment_priorReasoning": "capabilities.priorReasoning declares the provider's prior-reasoning contract: 'required' (xAI/Kimi — must echo reasoning_content every turn; omitting it is xAI's #1 cache-miss cause), 'required-with-tools' (DeepSeek — 400s if omitted on tool chains, stripped otherwise), 'ignored' (OpenAI — silently drops the field; gateway strips it to save tokens). Unset = history kept as-is (cache-safe default). Verified 2026-08-29, see documentation/LLM APIs provider docs.",
      "imageInputLimit": {
        "maxDimension": 2048,
        "maxFileSize": 52428800,
        "supportedFormats": ["png", "jpeg", "gif", "webp"]
      }
    },
    
    "llama-embed": {
      "type": "embedding",
      "adapter": "openai",
      "provider": "Alibaba",
      "endpoint": "http://localhost:4080/v1",
      "adapterModel": "publisher/embedding-model-name",
      "capabilities": {
        "contextWindow": 32768,
        "dimensions": 2560
      }
    },

    "_comment_image": "--- Image generation (OpenRouter image-output chat model) ---",
    "krea-2-image": {
      "type": "image",
      "adapter": "openai",
      "provider": "Krea",
      "endpoint": "https://openrouter.ai/api/v1",
      "apiKey": "your-openrouter-api-key",
      "adapterModel": "krea/krea-2-medium-turbo",
      "capabilities": {
        "aspectRatios": ["1:1", "4:3", "3:2", "16:9", "2.35:1", "4:5", "2:3", "9:16"]
      },
      "_comment": "Served via POST /v1/images/generations. Client sends prompt + size (WxH, snapped to a declared aspectRatios entry) or aspect_ratio directly. Krea extras (seed, creativity, intensity/complexity/movement) ride in extraBody."
    },

    "_comment_image_edit": "--- Image generation + editing (image-to-image via input_references) ---",
    "qwen-image": {
      "type": "image",
      "adapter": "openai",
      "provider": "Alibaba",
      "endpoint": "https://openrouter.ai/api/v1",
      "apiKey": "your-openrouter-api-key",
      "adapterModel": "qwen/qwen-image-3",
      "capabilities": {
        "aspectRatios": ["1:1", "4:3", "3:2", "16:9", "2.35:1", "4:5", "2:3", "9:16"],
        "editing": true
      },
      "imageInputLimit": {
        "maxDimension": 2048,
        "maxFileSize": 10485760,
        "supportedFormats": ["png", "jpeg", "webp"]
      },
      "_comment": "capabilities.editing gates input_references (image-to-image). References are auto-conformed to imageInputLimit.maxDimension via the media processor (same as chat vision) and always sent as data URIs — zero-retention providers reject remote URLs."
    },
    
    "_comment_gemini": "--- Google Gemini ---",
    "gemini-flash": {
      "type": "chat",
      "adapter": "gemini",
      "provider": "Google",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "your-gemini-api-key",
      "adapterModel": "gemini-4-hydrogen",
      "capabilities": {
        "contextWindow": 1048576,
        "maxOutputTokens": 65536,
        "vision": true,
        "structuredOutput": "json_schema",
        "streaming": true,
        "thinkingLevels": ["low", "medium", "high", "xhigh"],
        "excludeParams": ["temperature", "top_p", "top_k"]
      }
    },
    "gemini-neon": {
      "type": "chat",
      "adapter": "gemini",
      "provider": "Google",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "your-gemini-api-key",
      "adapterModel": "gemini-4-neon",
      "reasoning_effort": "high",
      "capabilities": {
        "contextWindow": 1048576,
        "maxOutputTokens": 65536,
        "vision": true,
        "structuredOutput": "json_schema",
        "streaming": true,
        "thinkingLevels": ["low", "medium", "high", "xhigh"],
        "excludeParams": ["temperature", "top_p", "top_k"]
      },
      "_comment": "Gemini 4 Neon is paid-tier only. Same unified 1M window and 65,536-token synchronous hop as Hydrogen; four thinking levels with 'high' as the default."
    },
    "gemini-embedding": {
      "type": "embedding",
      "adapter": "gemini",
      "provider": "Google",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "your-gemini-api-key",
      "adapterModel": "gemini-embedding-2",
      "capabilities": {
        "contextWindow": 8192,
        "dimensions": 768
      }
    },
    
    "_comment_openai": "--- OpenAI ---",
    "openai-chat": {
      "type": "chat",
      "adapter": "openai",
      "provider": "OpenAI",
      "endpoint": "https://api.openai.com/v1",
      "apiKey": "your-openai-api-key",
      "adapterModel": "gpt-6.2-sol",
      "capabilities": {
        "contextWindow": 1050000,
        "maxOutputTokens": 128000,
        "vision": true,
        "structuredOutput": true,
        "streaming": true,
        "thinkingLevels": ["low", "medium", "high", "xhigh", "max"]
      }
    },
    "openai-responses": {
      "type": "chat",
      "adapter": "responses",
      "provider": "OpenAI",
      "endpoint": "https://api.openai.com/v1",
      "apiKey": "your-openai-api-key",
      "adapterModel": "gpt-6.2-astra",
      "capabilities": {
        "contextWindow": 1050000,
        "maxOutputTokens": 128000,
        "vision": true,
        "streaming": true,
        "structuredOutput": true,
        "tools": true,
        "stateful": true,
        "thinkingLevels": ["low", "medium", "high", "xhigh", "max"]
      },
      "_comment_budget": "No model-level maxTokens: the responses adapter lets it override the client's max_tokens, which would clamp the caller. A default budget belongs in a task's maxTokens (client-overridable), or in defaultMaxTokens for an upstream that REQUIRES the field."
    },
    
    "_comment_grok": "--- xAI Grok ---",
    "grok-chat": {
      "type": "chat",
      "adapter": "openai",
      "provider": "xAI",
      "endpoint": "https://api.x.ai/v1",
      "apiKey": "your-grok-api-key",
      "adapterModel": "grok-2",
      "capabilities": {
        "contextWindow": 1000000,
        "vision": true,
        "structuredOutput": true,
        "streaming": true,
        "thinkingLevels": ["low", "medium", "high"],
        "thinkingEffortField": "reasoning_effort"
      },
      "_comment_thinking": "thinkingLevels declares the reasoning_effort values this model accepts; the router 400s on anything else. thinkingEffortField tells the openai adapter to pass the value through as top-level reasoning_effort."
    },
    
    "_comment_priorReasoning": "priorReasoning declares how prior reasoning_content is handled in history: 'required' echo it, 'required-with-tools' echo it when tools are present, 'ignored' strip it. Separately, thinkingBlockRequired (boolean) declares a measured fact: the provider REFUSES an assistant turn that carries no thinking block and accepts an EMPTY one (DeepSeek true, Kimi false — probed 2026-10-16). Only a model that sets it receives empty placeholder blocks.",
    "_comment_anthropic": "--- Anthropic Claude (native Anthropic requires max_tokens, so declare defaultMaxTokens for clients that send none) ---",
    "anthropic-chat": {
      "type": "chat",
      "adapter": "anthropic",
      "provider": "Anthropic",
      "endpoint": "https://api.anthropic.com",
      "apiKey": "your-anthropic-api-key",
      "adapterModel": "claude-sonnet-5-5",
      "defaultMaxTokens": 128000,
      "capabilities": {
        "contextWindow": 1000000,
        "maxOutputTokens": 128000,
        "vision": true,
        "streaming": true,
        "structuredOutput": true,
        "tools": true,
        "anthropicVersion": "2023-06-01",
        "promptCaching": true
      },
      "_comment_endpoint": "endpoint must omit /v1 — the adapter appends /v1/messages. anthropicVersion triggers x-api-key + anthropic-version headers (native Anthropic).",
      "_comment_promptCaching": "promptCaching auto-injects top-level cache_control (automatic caching); use \"1h\" instead of true for the 1-hour TTL. Only native Anthropic supports cache_control — do NOT set it on third-party anthropic-protocol providers (Kimi, DeepSeek, MiniMax, z.AI)."
    },
    
    "_comment_kimi": "--- Moonshot Kimi (Anthropic Messages API; requires max_tokens, so declare defaultMaxTokens) ---",
    "kimi-chat": {
      "type": "chat",
      "adapter": "anthropic",
      "provider": "Moonshot",
      "endpoint": "https://api.kimi.com/coding",
      "apiKey": "your-kimi-api-key",
      "adapterModel": "kimi-for-coding",
      "defaultMaxTokens": 8192,
      "capabilities": {
        "contextWindow": 256000,
        "maxOutputTokens": 8192,
        "vision": true,
        "structuredOutput": true,
        "streaming": true
      }
    },
    
    "_comment_alibaba": "--- Alibaba/DashScope: route via the openai adapter (DashScope's OpenAI-compatible endpoint). The separate 'alibaba' adapter was removed from the registry. ---",
    "alibaba-chat": {
      "type": "chat",
      "adapter": "openai",
      "provider": "Alibaba",
      "endpoint": "https://coding-intl.dashscope.aliyuncs.com/v1",
      "apiKey": "your-dashscope-api-key",
      "adapterModel": "qwen3.5-plus",
      "capabilities": {
        "contextWindow": 1000000,
        "maxOutputTokens": 65536,
        "vision": true,
        "structuredOutput": true,
        "streaming": true,
        "excludeParams": ["top_p"]
      },
      "_comment_excludeParams": "excludeParams strips params the upstream rejects (e.g. reasoning models that reject sampling params)."
    },
    
    "_comment_dashscope_compat": "--- DashScope via OpenAI-compatible endpoint ---",
    "dashscope-kimi": {
      "type": "chat",
      "adapter": "openai",
      "provider": "Moonshot",
      "endpoint": "https://coding-intl.dashscope.aliyuncs.com/v1",
      "apiKey": "your-dashscope-api-key",
      "adapterModel": "kimi-k2.5",
      "capabilities": {
        "contextWindow": 256000,
        "maxOutputTokens": 98304,
        "vision": true,
        "structuredOutput": true,
        "streaming": true
      }
    },
    
    "_comment_mistral": "--- Mistral Large 4 + Small 4 (native OpenAI-compatible API; thinkingChunks converts Mistral ThinkChunk history) ---",
    "mistral-large-chat": {
      "type": "chat",
      "adapter": "openai",
      "provider": "Mistral",
      "endpoint": "https://api.mistral.ai/v1",
      "apiKey": "your-mistral-api-key",
      "adapterModel": "mistral-large-4-0",
      "reasoning_effort": "high",
      "capabilities": {
        "contextWindow": 1048576,
        "vision": true,
        "structuredOutput": true,
        "streaming": true,
        "tools": true,
        "thinkingLevels": ["low", "medium", "high"],
        "thinkingEffortField": "reasoning_effort",
        "thinkingChunks": "mistral",
        "priorReasoning": "required"
      }
    },
    "mistral-small-chat": {
      "type": "chat",
      "adapter": "openai",
      "provider": "Mistral",
      "endpoint": "https://api.mistral.ai/v1",
      "apiKey": "your-mistral-api-key",
      "adapterModel": "mistral-small-2603",
      "reasoning_effort": "none",
      "capabilities": {
        "contextWindow": 262144,
        "vision": true,
        "structuredOutput": true,
        "streaming": true,
        "tools": true,
        "thinkingLevels": ["none", "high"],
        "thinkingEffortField": "reasoning_effort",
        "thinkingChunks": "mistral",
        "priorReasoning": "required"
      }
    },

    "_comment_disabled": "--- Disabled Model Example ---",
    "disabled-model": {
      "type": "chat",
      "adapter": "openai",
      "provider": "OpenAI",
      "endpoint": "https://api.openai.com/v1",
      "apiKey": "your-api-key",
      "adapterModel": "gpt-4",
      "disabled": true,
      "capabilities": {
        "contextWindow": 128000,
        "vision": true,
        "streaming": true
      }
    }
  },
  
  "thinking": {
    "enabled": false,
    "stripTags": ["think", "thinking", "thought", "reasoning"],
    "orphanCloseAsSeparator": true,
    "maxThinkingContent": 8192
  },
  
  
  "mediaProcessor": {
    "enabled": true,
    "endpoint": "http://localhost:3500"
  },

  "imageFetcher": {
    "_comment": "SSRF allowlist for image fetching. The co-located chat backend serves attachment bucket images on a LAN address (e.g. 192.168.0.100:8080) that the default private-IP guard rejects. List the trusted host(s) here.",
    "allowedHosts": ["192.168.0.100"]
  },

  "accessKey": null,

  "mediaStorage": {
    "_comment": "File-based media storage for generated images/audio. TTL keyed on creation time (parsed from filename).",
    "enabled": true,
    "ttlMinutes": 60,
    "cleanupIntervalMs": 60000
  },

  "tasks": {
    "_comment": "=== TASK-BASED QUERY SYSTEM ===",
    "_comment_note": "Tasks define semantic routing with preset parameters. Client request params override task defaults.",
    
    "query": {
      "model": "openai-chat",
      "description": "General query and conversation",
      "maxTokens": 4096,
      "temperature": 0.7,
      "default": true
    },
    "inspect": {
      "model": "openai-chat",
      "description": "Code inspection and analysis",
      "maxTokens": 8192,
      "temperature": 0.4
    },
    "synthesis": {
      "model": "gemini-flash",
      "description": "Content synthesis and summarization",
      "maxTokens": 2048,
      "temperature": 0.4,
      "systemPrompt": "Summarize the following content concisely."
    },
    "analysis": {
      "model": "gemini-flash",
      "description": "Deep analysis and reasoning",
      "maxTokens": 8192,
      "temperature": 0.4
    },
    "embed": {
      "model": "gemini-embedding",
      "fallback": "llama-embed",
      "fallbackCooldownMinutes": 60,
      "description": "Text embedding generation",
      "default": true
    },
    "vision": {
      "model": "gemini-flash",
      "description": "Image understanding and visual analysis",
      "maxTokens": 4096,
      "temperature": 0.4
    },
    "imagegen": {
      "model": "krea-2-image",
      "description": "Image generation",
      "default": true
    }
  }
}

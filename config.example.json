{
  "port": 3400,
  "host": "0.0.0.0",
  
  "models": {
    "_comment": "=== LLM GATEWAY MODEL CONFIGURATION ===",
    
    "_comment_llamacpp": "--- llama.cpp wrapper (OpenAI-compatible) ---",
    "_comment_llamacpp_note": "The wrapper is a standalone process manager for llama-server. Configure launch params (pooling, ctxSize, etc.) in the wrapper's models.json, not here. The gateway only needs adapterModel (the model name) and endpoint.",
    
    "llama-chat": {
      "type": "chat",
      "adapter": "openai",
      "endpoint": "http://localhost:4080/v1",
      "adapterModel": "publisher/model-name",
      "maxTokens": 8192,
      "extraBody": {
        "stop": ["<end_of_turn>"]
      },
      "capabilities": {
        "contextWindow": 128000,
        "vision": true,
        "streaming": true,
        "structuredOutput": true,
        "tools": true,
        "thinking": "chat_template_kwargs"
      },
      "_comment_thinking": "capabilities.thinking='chat_template_kwargs' lets enable_thinking reach llama.cpp/Qwen upstreams via the openai adapter.",
      "imageInputLimit": {
        "maxDimension": 2048,
        "maxFileSize": 52428800,
        "supportedFormats": ["png", "jpeg", "gif", "webp"]
      }
    },
    
    "llama-embed": {
      "type": "embedding",
      "adapter": "openai",
      "endpoint": "http://localhost:4080/v1",
      "adapterModel": "publisher/embedding-model-name",
      "capabilities": {
        "contextWindow": 32768,
        "dimensions": 2560
      }
    },
    
    "_comment_gemini": "--- Google Gemini ---",
    "gemini-flash": {
      "type": "chat",
      "adapter": "gemini",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "your-gemini-api-key",
      "adapterModel": "gemini-2.0-flash",
      "capabilities": {
        "contextWindow": 1000000,
        "vision": true,
        "structuredOutput": "json_schema",
        "streaming": true
      }
    },
    "gemini-embedding": {
      "type": "embedding",
      "adapter": "gemini",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "your-gemini-api-key",
      "adapterModel": "embedding-001",
      "capabilities": {
        "contextWindow": 2048,
        "dimensions": 768
      }
    },
    "gemini-image": {
      "type": "image",
      "adapter": "gemini",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "your-gemini-api-key",
      "adapterModel": "imagen-4.0-generate-001",
      "capabilities": {
        "maxResolution": "2048x2048",
        "supportedFormats": ["png", "jpeg", "webp"]
      }
    },
    "gemini-tts": {
      "type": "audio",
      "adapter": "gemini",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta",
      "apiKey": "your-gemini-api-key",
      "adapterModel": "gemini-2.5-pro-preview-tts",
      "capabilities": {
        "tts": true,
        "maxDuration": 600,
        "supportedFormats": ["mp3", "wav", "pcm"]
      }
    },
    
    "_comment_openai": "--- OpenAI ---",
    "openai-chat": {
      "type": "chat",
      "adapter": "openai",
      "endpoint": "https://api.openai.com/v1",
      "apiKey": "your-openai-api-key",
      "adapterModel": "gpt-4o",
      "capabilities": {
        "contextWindow": 128000,
        "vision": true,
        "structuredOutput": true,
        "streaming": true
      }
    },
    "openai-image": {
      "type": "image",
      "adapter": "openai",
      "endpoint": "https://api.openai.com/v1",
      "apiKey": "your-openai-api-key",
      "adapterModel": "dall-e-3",
      "capabilities": {
        "maxResolution": "1024x1024",
        "supportedFormats": ["png", "jpeg"]
      }
    },
    "openai-tts": {
      "type": "audio",
      "adapter": "openai",
      "endpoint": "https://api.openai.com/v1",
      "apiKey": "your-openai-api-key",
      "adapterModel": "tts-1",
      "capabilities": {
        "streaming": false
      }
    },
    "openai-responses": {
      "type": "chat",
      "adapter": "responses",
      "endpoint": "https://api.openai.com/v1",
      "apiKey": "your-openai-api-key",
      "adapterModel": "gpt-4o",
      "maxTokens": 4096,
      "capabilities": {
        "contextWindow": 128000,
        "vision": true,
        "streaming": true,
        "tools": true,
        "stateful": true
      }
    },
    
    "_comment_grok": "--- xAI Grok ---",
    "grok-chat": {
      "type": "chat",
      "adapter": "openai",
      "endpoint": "https://api.x.ai/v1",
      "apiKey": "your-grok-api-key",
      "adapterModel": "grok-2",
      "capabilities": {
        "contextWindow": 1000000,
        "vision": true,
        "structuredOutput": true,
        "streaming": true
      }
    },
    
    "_comment_anthropic": "--- Anthropic Claude (requires maxOutputTokens) ---",
    "anthropic-chat": {
      "type": "chat",
      "adapter": "anthropic",
      "endpoint": "https://api.anthropic.com/v1",
      "apiKey": "your-anthropic-api-key",
      "adapterModel": "claude-3-5-sonnet-20241022",
      "capabilities": {
        "contextWindow": 200000,
        "maxOutputTokens": 8192,
        "vision": true,
        "streaming": true,
        "structuredOutput": true
      }
    },
    
    "_comment_kimi": "--- Moonshot Kimi (Anthropic Messages API, requires maxOutputTokens) ---",
    "kimi-chat": {
      "type": "chat",
      "adapter": "anthropic",
      "endpoint": "https://api.kimi.com/coding",
      "apiKey": "your-kimi-api-key",
      "adapterModel": "kimi-for-coding",
      "capabilities": {
        "contextWindow": 256000,
        "maxOutputTokens": 8192,
        "vision": true,
        "structuredOutput": true,
        "streaming": true
      }
    },
    
    "_comment_alibaba": "--- Alibaba/DashScope: route via the openai adapter (DashScope's OpenAI-compatible endpoint). The separate 'alibaba' adapter was removed from the registry. ---",
    "alibaba-chat": {
      "type": "chat",
      "adapter": "openai",
      "endpoint": "https://coding-intl.dashscope.aliyuncs.com/v1",
      "apiKey": "your-dashscope-api-key",
      "adapterModel": "qwen3.5-plus",
      "capabilities": {
        "contextWindow": 1000000,
        "maxOutputTokens": 65536,
        "vision": true,
        "structuredOutput": true,
        "streaming": true,
        "excludeParams": ["top_p"]
      },
      "_comment_excludeParams": "excludeParams strips params the upstream rejects (e.g. reasoning models that reject sampling params)."
    },
    
    "_comment_dashscope_compat": "--- DashScope via OpenAI-compatible endpoint ---",
    "dashscope-kimi": {
      "type": "chat",
      "adapter": "openai",
      "endpoint": "https://coding-intl.dashscope.aliyuncs.com/v1",
      "apiKey": "your-dashscope-api-key",
      "adapterModel": "kimi-k2.5",
      "capabilities": {
        "contextWindow": 256000,
        "maxOutputTokens": 98304,
        "vision": true,
        "structuredOutput": true,
        "streaming": true
      }
    },
    
    "_comment_disabled": "--- Disabled Model Example ---",
    "disabled-model": {
      "type": "chat",
      "adapter": "openai",
      "endpoint": "https://api.openai.com/v1",
      "apiKey": "your-api-key",
      "adapterModel": "gpt-4",
      "disabled": true,
      "capabilities": {
        "contextWindow": 128000,
        "vision": true,
        "streaming": true
      }
    }
  },
  
  "thinking": {
    "enabled": false,
    "stripTags": ["think", "thinking", "thought", "reasoning"],
    "orphanCloseAsSeparator": true,
    "maxThinkingContent": 8192
  },
  
  
  "mediaProcessor": {
    "enabled": true,
    "endpoint": "http://localhost:3500"
  },

  "accessKey": null,

  "mediaStorage": {
    "_comment": "File-based media storage for generated images/audio. TTL keyed on creation time (parsed from filename).",
    "enabled": true,
    "ttlMinutes": 60,
    "cleanupIntervalMs": 60000
  },

  "tasks": {
    "_comment": "=== TASK-BASED QUERY SYSTEM ===",
    "_comment_note": "Tasks define semantic routing with preset parameters. Client request params override task defaults.",
    
    "query": {
      "model": "openai-chat",
      "description": "General query and conversation",
      "maxTokens": 4096,
      "temperature": 0.7,
      "default": true
    },
    "inspect": {
      "model": "openai-chat",
      "description": "Code inspection and analysis",
      "maxTokens": 8192,
      "temperature": 0.4
    },
    "synthesis": {
      "model": "gemini-flash",
      "description": "Content synthesis and summarization",
      "maxTokens": 2048,
      "temperature": 0.4,
      "systemPrompt": "Summarize the following content concisely."
    },
    "analysis": {
      "model": "gemini-flash",
      "description": "Deep analysis and reasoning",
      "maxTokens": 8192,
      "temperature": 0.4
    },
    "embed": {
      "model": "gemini-embedding",
      "fallback": "llama-embed",
      "fallbackCooldownMinutes": 60,
      "description": "Text embedding generation",
      "default": true
    },
    "vision": {
      "model": "gemini-flash",
      "description": "Image understanding and visual analysis",
      "maxTokens": 4096,
      "temperature": 0.4
    },
    "image": {
      "model": "openai-image",
      "description": "Image generation from text prompts",
      "default": true
    },
    "tts": {
      "model": "openai-tts",
      "description": "Text-to-speech synthesis",
      "default": true
    }
  }
}
